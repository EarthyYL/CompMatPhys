&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = '.'
   prefix           = 'FeAl'
   pseudo_dir       = '/home/yluo/ASE/05_volume_optimization/CMP_pseudos'
/
&SYSTEM
   ecutwfc          = 90.0
   ecutrho          = 900.0
   occupations      = 'smearing'
