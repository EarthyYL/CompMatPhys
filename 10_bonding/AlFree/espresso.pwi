&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = '.'
   prefix           = 'AlFree'
   pseudo_dir       = '/home/yluo/ASE/pseudopotential-library'
/
&SYSTEM
   ecutwfc          = 40.0
   ecutrho          = 160.0
   occupations      = 'smearing'
   degauss          = 0.005
   smearing         = 'mv'
   nspin            = 2
   starting_magnetization(1) = 0.0
   ntyp             = 1
   nat              = 1
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.7
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Al  26.9815385 Al.pbe-n-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
1 1 1  0 0 0

CELL_PARAMETERS angstrom
15.00000000000000 0.00000000000000 0.00000000000000
0.00000000000000 15.00000000000000 0.00000000000000
0.00000000000000 0.00000000000000 15.00000000000000

ATOMIC_POSITIONS angstrom
Al  7.5000000000 7.5000000000 7.5000000000  

