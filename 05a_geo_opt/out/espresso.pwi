&CONTROL
   calculation      = 'vc-relax'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = '.'
   prefix           = 'FeAl'
   pseudo_dir       = '/home/yluo/ASE/05a_geo_opt/src'
/
&SYSTEM
   ecutwfc          = 60.0
   ecutrho          = 240.0
   occupations      = 'smearing'
   degauss          = 0.005
   smearing         = 'mv'
   ntyp             = 2
   nat              = 4
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.7
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   press            = 0.0
   press_conv_thr   = 0.5
/
&FCP
/
&RISM
/
