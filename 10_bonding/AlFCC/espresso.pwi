&CONTROL
   calculation      = 'scf'
   verbosity        = 'low'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = '.'
   prefix           = 'AlFCC'
   pseudo_dir       = '/home/yluo/ASE/pseudopotential-library'
/
&SYSTEM
   ecutwfc          = 40.0
   ecutrho          = 160.0
   occupations      = 'smearing'
   degauss          = 0.005
   smearing         = 'mv'
   ntyp             = 1
   nat              = 4
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
   mixing_beta      = 0.7
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
